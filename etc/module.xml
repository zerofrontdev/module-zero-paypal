    SPDX-License-Identifier: OSL-3.0 OR AFL-3.0

    Classic, business-email-only PayPal redirect for Zero Checkout. Magento 2 has
    no such method (its "Payments Standard" panel is Express Checkout and needs
    API credentials); Magento_Paypal is used for its IPN endpoint and Config.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Module/etc/module.xsd">
    <module name="Zero_Paypal" setup_version="1.0.0">
        <sequence>
            <module name="Zero_Core"/>
            <module name="Magento_Sales"/>
            <module name="Magento_Payment"/>
            <module name="Magento_Paypal"/>
            <module name="Magento_Checkout"/>
            <module name="Zero_Checkout"/>
        </sequence>
    </module>
</config>
